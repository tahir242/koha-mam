# ---------------------------------------------------------------------------
# Koha Media Asset Management (MAM)
# Only the settings you need to change are listed. Everything else has a
# sensible default in config/dam.php. After editing run: php artisan config:cache
# ---------------------------------------------------------------------------

# --- Application ---------------------------------------------------------------
APP_NAME="Koha MAM"
APP_ENV=production
APP_DEBUG=false
# Generate with: php artisan key:generate
APP_KEY=
# Address of this application (also used in the Koha 856 link). Do not change after go-live.
APP_URL=https://mam.example.org

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# --- Database, sessions, queue (database = simplest setup) -----------------------
DB_CONNECTION=sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Koha ------------------------------------------------------------------------
# Must match the plugin's "Instance ID".
KOHA_INSTANCE_ID=mylibrary
# Koha staff interface (also serves Koha's REST API).
KOHA_STAFF_URL=https://staff.koha.example.org
# Koha OPAC (catalogue links and cover images).
KOHA_OPAC_URL=https://koha.example.org
# Koha API key of the "dam-api" staff user (Patron > More > Manage API keys).
KOHA_API_CLIENT_ID=
KOHA_API_CLIENT_SECRET=

# --- Sign-in from the Koha plugin ------------------------------------------------
# Must match the plugin's "Client ID" and "Client secret" (64 hex: openssl rand -hex 32).
KOHA_SSO_CLIENT_ID=koha-mam
KOHA_SSO_CLIENT_SECRET=
# Koha userids that are always MAM administrators (comma-separated).
DAM_BOOTSTRAP_ADMINS=

# --- Test network without HTTPS: true only on an isolated test network, never in production ---
DAM_ALLOW_INSECURE_HTTP=false

# --- Files -------------------------------------------------------------------------
# "clamav" when ClamAV is installed, "none" on a test server without it.
DAM_MALWARE_SCANNER=clamav
DAM_MALWARE_SCAN_REQUIRED=true
